# Portfolio dataset root (external drive).
# Copy this file to `.env` (gitignored, never committed) and adjust if needed.
#
# PowerShell (persistent, user-level):
#   setx PORTFOLIO_DATA_ROOT "D:\GITHUB\AI-Portfolio\Portfolio data"
# PowerShell (current session only):
#   $env:PORTFOLIO_DATA_ROOT = "D:\GITHUB\AI-Portfolio\Portfolio data"
#
# All application code resolves datasets from this variable; there is no
# silent fallback to the internal drive. See docs/decisions/0003-external-data-root.md
PORTFOLIO_DATA_ROOT=D:\GITHUB\AI-Portfolio\Portfolio data

# LLM provider keys are NOT stored in the repository. RELIA's provider presets
# read them from your local .env only (never committed). One block is enough;
# see packages/relia/src/relia/providers/presets.py for the full list.
#
# Anthropic (Claude) — preset "claude":
#   RELIA_ANTHROPIC_API_KEY=sk-ant-...
#   RELIA_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
#   # optional pricing for the cost ledger (USD per million tokens):
#   RELIA_ANTHROPIC_INPUT_COST_PER_MTOKEN=3.0
#   RELIA_ANTHROPIC_OUTPUT_COST_PER_MTOKEN=15.0
#
# xAI (Grok) — preset "grok":
#   RELIA_GROK_API_KEY=xai-...
#   RELIA_GROK_DEFAULT_MODEL=grok-4
#
# OpenAI — preset "openai-compatible":
#   RELIA_LLM_API_KEY=sk-...
#   RELIA_LLM_DEFAULT_MODEL=gpt-4.1-mini
#
# Any other OpenAI-compatible endpoint (OpenRouter, vLLM, ...) — preset "custom":
#   RELIA_CUSTOM_API_KEY=...
#   RELIA_CUSTOM_BASE_URL=https://openrouter.ai/api/v1
#   RELIA_CUSTOM_DEFAULT_MODEL=...
