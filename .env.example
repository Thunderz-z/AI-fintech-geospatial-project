# Portfolio dataset root (external drive).
# Copy this file to `.env` (gitignored, never committed) and adjust if needed.
#
# PowerShell (persistent, user-level):
#   setx PORTFOLIO_DATA_ROOT "D:\GITHUB\AI-Portfolio\Portfolio data"
# PowerShell (current session only):
#   $env:PORTFOLIO_DATA_ROOT = "D:\GITHUB\AI-Portfolio\Portfolio data"
#
# All application code resolves datasets from this variable; there is no
# silent fallback to the internal drive. See docs/decisions/0003-external-data-root.md
PORTFOLIO_DATA_ROOT=D:\GITHUB\AI-Portfolio\Portfolio data

# LLM provider keys are NOT stored in the repository. When RELIA provider
# adapters need credentials, add them here in your local .env only:
# RELIA_PROVIDER_API_KEY=
